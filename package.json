{
  "name": "salud-de-una-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "npm run generate:api-types && next build",
    "generate:api-types": "openapi-typescript ./openapi/openapi.json -o src/types/api.generated.ts",
    "format": "prettier --write .",
    "start": "next start",
    "typecheck": "tsc --project tsconfig.json --pretty --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "check:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "check:types": "tsc --project tsconfig.json --pretty --noEmit",
    "deploy": "bash deploy/deploy.sh",
    "deploy:build": "bash deploy/deploy.sh --only-build",
    "deploy:verify": "bash deploy/deploy.sh --verify"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.16.2",
    "@base-ui/react": "^1.4.1",
    "@lucide/lab": "^0.1.2",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "playwright": "^1.60.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "3.8.1",
    "shadcn": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-react-aria-components": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.7.7",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.100.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
